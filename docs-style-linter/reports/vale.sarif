        {
          "ruleId": "TikTokDocs.Acronyms",
          "level": "note",
          "message": {
            "text": "'UID' is used without being defined on this page."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "corpus/meilisearch-docs/reference/api/headers.mdx"
                },
                "region": {
                  "startLine": 82,
                  "startColumn": 107,
                  "endColumn": 110,
                  "snippet": {
                    "text": "UID"
                  }
